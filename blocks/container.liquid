{%- liquid
  assign block_settings = block.settings
  assign background_image = block_settings.image_desktop | default: block_settings.image_mobile

  case block_settings.max_width
    when '2xl'
      assign max_width_class = 'max-w-(--breakpoint-2xl)'
    when 'xl'
      assign max_width_class = 'max-w-(--breakpoint-xl)'
    when 'lg'
      assign max_width_class = 'max-w-(--breakpoint-lg)'
    when 'md'
      assign max_width_class = 'max-w-(--breakpoint-md)'
    when 'sm'
      assign max_width_class = 'max-w-(--breakpoint-sm)'
    when 'xs'
      assign max_width_class = 'max-w-(--breakpoint-xs)'
    when '2xs'
      assign max_width_class = 'max-w-(--breakpoint-2xs)'
    else
      assign max_width_class = 'max-w-full'
  endcase
-%}

{%- capture block_content -%}
  {% content_for 'blocks' %}
{%- endcapture -%}

<div
  class="container relative w-full {{ max_width_class }}{% if block_settings.classnames != blank %} {{ block_settings.classnames | escape }}{% endif %}"
  {% if block_settings.background_color != blank %}
    style="background-color: {{ block_settings.background_color }};"
  {% endif %}
  {{ block.shopify_attributes }}
>
  {%- if background_image != blank -%}
    <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
      {% render 'media-image',
        image_mobile: block_settings.image_mobile,
        image_desktop: block_settings.image_desktop,
        widths_preset: 'banner',
        sizes: '100vw',
        decorative: true,
        class: 'h-full w-full max-w-none object-cover',
        picture_class: 'h-full w-full'
      %}
    </div>
  {%- endif -%}

  {%- if background_image != blank -%}
    <div class="relative z-10">
      {{ block_content }}
    </div>
  {%- else -%}
    {{ block_content }}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Container",
  "tag": null,
  "blocks": [
    {
      "type": "@theme"
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "max_width",
      "label": "Max width",
      "options": [
        {
          "value": "full",
          "label": "Full"
        },
        {
          "value": "2xl",
          "label": "2XL"
        },
        {
          "value": "xl",
          "label": "XL"
        },
        {
          "value": "lg",
          "label": "LG"
        },
        {
          "value": "md",
          "label": "MD"
        },
        {
          "value": "sm",
          "label": "SM"
        },
        {
          "value": "xs",
          "label": "XS"
        },
        {
          "value": "2xs",
          "label": "2XS"
        }
      ],
      "default": "full"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image"
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Desktop image"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color"
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "textarea",
      "id": "classnames",
      "label": "classnames"
    }
  ],
  "presets": [
    {
      "name": "Container",
      "category": "Layout"
    }
  ]
}
{% endschema %}