{%- liquid
  assign block_settings = block.settings
  assign background_image = block_settings.image_desktop | default: block_settings.image_mobile
  assign background_image_mobile = block_settings.image_mobile | default: block_settings.image_desktop
  assign background_image_desktop = block_settings.image_desktop | default: block_settings.image_mobile

  case block_settings.max_width
    when '2xl'
      assign max_width_class = 'max-w-(--breakpoint-2xl)'
    when 'xl'
      assign max_width_class = 'max-w-(--breakpoint-xl)'
    when 'lg'
      assign max_width_class = 'max-w-(--breakpoint-lg)'
    when 'md'
      assign max_width_class = 'max-w-(--breakpoint-md)'
    when 'sm'
      assign max_width_class = 'max-w-(--breakpoint-sm)'
    when 'xs'
      assign max_width_class = 'max-w-(--breakpoint-xs)'
    when '2xs'
      assign max_width_class = 'max-w-(--breakpoint-2xs)'
    else
      assign max_width_class = 'max-w-full'
  endcase

  if background_image != blank
    assign container_layout_class = 'aspect-[var(--background-image-aspect-mobile)] sm:aspect-[var(--background-image-aspect-desktop)]'
  else
    assign container_layout_class = ''
  endif

  case block_settings.background_position
    when 'top'
      assign background_position_class = 'object-top'
    when 'bottom'
      assign background_position_class = 'object-bottom'
    else
      assign background_position_class = 'object-center'
  endcase

  assign background_image_class = 'h-full w-full max-w-none object-cover ' | append: background_position_class
  if block_settings.background_image_classnames != blank
    assign escaped_background_image_classnames = block_settings.background_image_classnames | escape
    assign background_image_class = background_image_class | append: ' ' | append: escaped_background_image_classnames
  endif
-%}

{%- capture block_content -%}
  {% content_for 'blocks' %}
{%- endcapture -%}

<div
  class="relative mx-auto grid w-full {{ max_width_class }}{% if container_layout_class != blank %} {{ container_layout_class }}{% endif %}{% if block_settings.classnames != blank %} {{ block_settings.classnames | escape }}{% endif %}"
  {% if block_settings.background_color != blank or background_image != blank %}
    style="{% if block_settings.background_color != blank %}background-color: {{ block_settings.background_color }};{% endif %}{% if background_image != blank %} --background-image-aspect-mobile: {{ background_image_mobile.aspect_ratio | default: 1 }}; --background-image-aspect-desktop: {{ background_image_desktop.aspect_ratio | default: 2 }};{% endif %}"
  {% endif %}
  {{ block.shopify_attributes }}
>
  {%- if background_image != blank -%}
    <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
      {% render 'media-image',
        image_mobile: block_settings.image_mobile,
        image_desktop: block_settings.image_desktop,
        widths_preset: 'banner',
        sizes: '100vw',
        decorative: true,
        class: background_image_class,
        picture_class: 'h-full w-full'
      %}
    </div>
  {%- endif -%}

  <div class="relative z-10 grid w-full">
    {{ block_content }}
  </div>
</div>

{% schema %}
{
  "name": "Container",
  "tag": null,
  "blocks": [
    {
      "type": "@theme"
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "max_width",
      "label": "Max width",
      "info": "Choose Fill available width for most layouts. Smaller widths center the content.",
      "options": [
        {
          "value": "full",
          "label": "Fill available width"
        },
        {
          "value": "2xl",
          "label": "Extra wide - 1536px max"
        },
        {
          "value": "xl",
          "label": "Wide - 1280px max"
        },
        {
          "value": "lg",
          "label": "Large - 1024px max"
        },
        {
          "value": "md",
          "label": "Medium - 768px max"
        },
        {
          "value": "sm",
          "label": "Compact - 640px max"
        },
        {
          "value": "xs",
          "label": "Small - 480px max"
        },
        {
          "value": "2xs",
          "label": "Extra small - 400px max"
        }
      ],
      "default": "full"
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image"
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Desktop image"
    },
    {
      "type": "select",
      "id": "background_position",
      "label": "Image position",
      "options": [
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ],
      "default": "center"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color"
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "textarea",
      "id": "classnames",
      "label": "Custom classes (advanced)"
    },
    {
      "type": "textarea",
      "id": "background_image_classnames",
      "label": "Custom background image classes (advanced)"
    }
  ],
  "presets": [
    {
      "name": "Container",
      "category": "Layout"
    }
  ]
}
{% endschema %}
