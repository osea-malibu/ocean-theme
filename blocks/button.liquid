{%- liquid
  assign block_settings = block.settings

  case block_settings.style
    when 'secondary'
      assign style_class = 'button button-secondary'
    when 'tertiary'
      assign style_class = 'button button-tertiary'
    when 'text_link'
      assign style_class = 'link inline-block'
    else
      assign style_class = 'button button-primary'
  endcase

  if block_settings.style == 'text_link'
    case block_settings.size
      when 'small'
        assign size_class = 'text-sm'
      when 'large'
        assign size_class = 'text-lg'
      else
        assign size_class = 'text-base'
    endcase
  else
    case block_settings.size
      when 'small'
        assign size_class = 'button-sm'
      when 'large'
        assign size_class = 'button-lg'
      else
        assign size_class = 'button-md'
    endcase
  endif

  case block_settings.alignment
    when 'center'
      assign alignment_class = 'mx-auto self-center justify-self-center'
    when 'right'
      assign alignment_class = 'ml-auto self-end justify-self-end'
    else
      assign alignment_class = 'mr-auto self-start justify-self-start'
  endcase

  case block_settings.visibility
    when 'mobile_only'
      assign visibility_class = 'sm:hidden'
    when 'desktop_only'
      if block_settings.style == 'text_link'
        assign visibility_class = 'hidden sm:inline-block'
      else
        assign visibility_class = 'hidden sm:inline-flex'
      endif
    else
      assign visibility_class = ''
  endcase
-%}

{%- if block_settings.label != blank -%}
  <div
    class="w-fit {{ alignment_class }}{% if visibility_class != blank %} {{ visibility_class }}{% endif %}"
    {{ block.shopify_attributes }}
  >
    <a
      {% if block_settings.link != blank %}
        href="{{ block_settings.link }}"
      {% else %}
        role="link"
        aria-disabled="true"
      {% endif %}
      {% if block_settings.open_in_new_tab and block_settings.link != blank %}
        target="_blank"
        rel="noopener noreferrer"
      {% endif %}
      {% if block_settings.accessibility_label != blank %}
        aria-label="{{ block_settings.accessibility_label | escape }}"
      {% endif %}
      class="{{ style_class }} {{ size_class }}{% if block_settings.classnames != blank %} {{ block_settings.classnames | escape }}{% endif %}"
    >
      {{- block_settings.label | escape -}}
    </a>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Button",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Button label"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "Open in new tab",
      "default": false
    },
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Accessibility label (optional)",
      "info": "Use when the visible label does not clearly describe the link destination."
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        {
          "value": "primary",
          "label": "Primary"
        },
        {
          "value": "secondary",
          "label": "Secondary"
        },
        {
          "value": "tertiary",
          "label": "Tertiary"
        },
        {
          "value": "text_link",
          "label": "Text link"
        }
      ],
      "default": "primary"
    },
    {
      "type": "select",
      "id": "size",
      "label": "Size",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "regular",
          "label": "Regular"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "regular"
    },
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "Alignment",
      "default": "left"
    },
    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "select",
      "id": "visibility",
      "label": "Visibility",
      "options": [
        {
          "value": "all",
          "label": "Show everywhere"
        },
        {
          "value": "mobile_only",
          "label": "Mobile only"
        },
        {
          "value": "desktop_only",
          "label": "Desktop only"
        }
      ],
      "default": "all"
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "textarea",
      "id": "classnames",
      "label": "Classnames",
      "info": "Optional Tailwind classes for developer styling."
    }
  ],
  "presets": [
    {
      "name": "Button",
      "category": "Text"
    }
  ]
}
{% endschema %}
