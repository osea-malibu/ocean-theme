{%- liquid
  case block.settings.layout
    when 'grid_3'
      assign layout_class = 'grid grid-cols-1 gap-4 sm:grid-cols-2 md:gap-6 lg:grid-cols-3 lg:gap-8'
    when 'grid_4'
      assign layout_class = 'grid grid-cols-1 gap-4 sm:grid-cols-2 md:gap-6 lg:grid-cols-4 lg:gap-8'
    when 'grid_5'
      assign layout_class = 'grid grid-cols-1 gap-4 sm:grid-cols-2 md:grid-cols-3 md:gap-6 lg:gap-8 xl:grid-cols-5'
    when 'grid_6'
      assign layout_class = 'grid grid-cols-1 gap-4 sm:grid-cols-2 md:grid-cols-3 md:gap-6 lg:gap-8 xl:grid-cols-6'
    else
      assign layout_class = 'grid grid-cols-1 gap-4 sm:grid-cols-2 md:gap-6 lg:gap-8'
  endcase
-%}

<div
  class="w-full {{ layout_class }}{% if block.settings.classnames != blank %} {{ block.settings.classnames | escape }}{% endif %}"
  {{ block.shopify_attributes }}
>
  {% content_for 'blocks' %}
</div>

{% schema %}
{
  "name": "Grid group",
  "tag": null,
  "blocks": [
    {
      "type": "@theme"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "info": "The number of items per row adjusts automatically on smaller screens.",
      "options": [
        {
          "value": "grid_2",
          "label": "2 items per row"
        },
        {
          "value": "grid_3",
          "label": "3 items per row"
        },
        {
          "value": "grid_4",
          "label": "4 items per row"
        },
        {
          "value": "grid_5",
          "label": "5 items per row"
        },
        {
          "value": "grid_6",
          "label": "6 items per row"
        }
      ],
      "default": "grid_2"
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "textarea",
      "id": "classnames",
      "label": "Custom classes (advanced)"
    }
  ],
  "presets": [
    {
      "name": "Grid group",
      "category": "Layout"
    }
  ]
}
{% endschema %}
