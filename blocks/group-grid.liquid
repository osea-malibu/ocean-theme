{%- liquid
  case block.settings.group_position
    when 'left_half'
      assign position_class = 'w-full justify-self-start sm:w-1/2'
    when 'center_half'
      assign position_class = 'w-full justify-self-center sm:w-1/2'
    when 'right_half'
      assign position_class = 'w-full justify-self-end sm:w-1/2'
    else
      assign position_class = 'w-full justify-self-stretch'
  endcase

  case block.settings.vertical_position
    when 'top'
      assign vertical_position_class = 'self-start'
    when 'bottom'
      assign vertical_position_class = 'self-end'
    else
      assign vertical_position_class = 'self-center'
  endcase

  case block.settings.layout
    when 'grid_3'
      assign layout_class = 'grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-3'
    when 'grid_4'
      assign layout_class = 'grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-4'
    when 'grid_5'
      assign layout_class = 'grid grid-cols-1 gap-2 sm:grid-cols-2 md:grid-cols-3 xl:grid-cols-5'
    when 'grid_6'
      assign layout_class = 'grid grid-cols-1 gap-2 sm:grid-cols-2 md:grid-cols-3 xl:grid-cols-6'
    else
      assign layout_class = 'grid grid-cols-1 gap-2 sm:grid-cols-2'
  endcase
-%}

<div
  class="{{ position_class }} {{ vertical_position_class }}"
  {{ block.shopify_attributes }}
>
  <div class="w-full {{ layout_class }}{% if block.settings.classnames != blank %} {{ block.settings.classnames | escape }}{% endif %}">
    {% content_for 'blocks' %}
  </div>
</div>

{% schema %}
{
  "name": "Grid group",
  "tag": null,
  "blocks": [
    {
      "type": "@theme"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "group_position",
      "label": "Group width and position",
      "info": "Half-width groups become full width on mobile.",
      "options": [
        {
          "value": "full",
          "label": "Full width"
        },
        {
          "value": "left_half",
          "label": "Left half"
        },
        {
          "value": "center_half",
          "label": "Center half"
        },
        {
          "value": "right_half",
          "label": "Right half"
        }
      ],
      "default": "full"
    },
    {
      "type": "select",
      "id": "vertical_position",
      "label": "Vertical position",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "info": "The number of items per row adjusts automatically on smaller screens.",
      "options": [
        {
          "value": "grid_2",
          "label": "2 items per row"
        },
        {
          "value": "grid_3",
          "label": "3 items per row"
        },
        {
          "value": "grid_4",
          "label": "4 items per row"
        },
        {
          "value": "grid_5",
          "label": "5 items per row"
        },
        {
          "value": "grid_6",
          "label": "6 items per row"
        }
      ],
      "default": "grid_2"
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "textarea",
      "id": "classnames",
      "label": "Custom classes (advanced)"
    }
  ],
  "presets": [
    {
      "name": "Grid group",
      "category": "Layout"
    }
  ]
}
{% endschema %}
