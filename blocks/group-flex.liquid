{%- liquid
  case block.settings.group_position
    when 'left_half'
      assign position_class = 'w-full justify-self-start sm:w-1/2'
    when 'center_half'
      assign position_class = 'w-full justify-self-center sm:w-1/2'
    when 'right_half'
      assign position_class = 'w-full justify-self-end sm:w-1/2'
    else
      assign position_class = 'w-full justify-self-stretch'
  endcase

  case block.settings.vertical_position
    when 'top'
      assign vertical_position_class = 'self-start'
    when 'bottom'
      assign vertical_position_class = 'self-end'
    else
      assign vertical_position_class = 'self-center'
  endcase

  case block.settings.layout
    when 'split_50_50'
      assign layout_class = 'flex w-full flex-col gap-4 md:flex-row md:flex-wrap md:[&>.theme-image-block]:mx-0 md:[&>*]:min-w-0 md:[&>*]:shrink-0 md:[&>*]:basis-[calc(50%-0.5rem)]'
    when 'wrap'
      assign layout_class = 'flex flex-row flex-wrap -m-2 w-[calc(100%+1rem)] [&>*]:p-2 [&>.theme-image-block]:mx-0'
    else
      assign layout_class = 'flex w-full flex-col gap-4'
  endcase
-%}

<div
  class="{{ position_class }} {{ vertical_position_class }}"
  {{ block.shopify_attributes }}
>
  <div class="{{ layout_class }}{% if block.settings.classnames != blank %} {{ block.settings.classnames | escape }}{% endif %}">
    {% content_for 'blocks' %}
  </div>
</div>

{% schema %}
{
  "name": "Flex group",
  "tag": null,
  "blocks": [
    {
      "type": "@theme"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "group_position",
      "label": "Group width and position",
      "info": "Half-width groups become full width on mobile.",
      "options": [
        {
          "value": "full",
          "label": "Full width"
        },
        {
          "value": "left_half",
          "label": "Left half"
        },
        {
          "value": "center_half",
          "label": "Center half"
        },
        {
          "value": "right_half",
          "label": "Right half"
        }
      ],
      "default": "full"
    },
    {
      "type": "select",
      "id": "vertical_position",
      "label": "Vertical position",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "info": "The two-column layout stacks on mobile. Flex wrap keeps each block's own width.",
      "options": [
        {
          "value": "stacked",
          "label": "Vertical stack"
        },
        {
          "value": "split_50_50",
          "label": "Two equal columns (stacks on mobile)"
        },
        {
          "value": "wrap",
          "label": "Flex wrap (uses each block's width)"
        }
      ],
      "default": "stacked"
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "textarea",
      "id": "classnames",
      "label": "Custom classes (advanced)"
    }
  ],
  "presets": [
    {
      "name": "Flex group",
      "category": "Layout"
    }
  ]
}
{% endschema %}
