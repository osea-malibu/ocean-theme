{% comment %}
  Rivo favorite (wishlist) heart for one product.
  Render the 'rivo-wishlist-assets' snippet once on the page too; it holds the script and styles.

  Accepts:
  - product: {Object} Product Liquid object (required)
{% endcomment %}
<div class="favorite-button-wrapper bg-white/75 rounded-full p-1">
  <rivo-favorite-button
    data-product-id="{{ product.id }}"
    rivo-ax-data
    rivo-ax-cloak
    rivo-ax-html="$store.icons.heart"
    rivo-ax-show="$store.rivo_aw_settings?.favorites_enabled && (!$store.rivo_profile_customer || $store.loading_states.global_favorite_buttons)"
  ></rivo-favorite-button>
</div>
