{% comment %}
  Script and styles for Rivo favorite hearts. Render once per page that renders
  'rivo-wishlist-heart' (directly or via card-product's show_wishlist).
{% endcomment %}
<script>
  (() => {
    // Guard: only initialize once, even if this snippet is rendered more than once on a page
    if (window.__rivoWishlistInitialized) return;
    window.__rivoWishlistInitialized = true;
    // GTM: emit a Google dataLayer event when the wishlist heart is clicked.
    // The heart is a toggle, so we read the resulting state and emit
    // add_to_wishlist / remove_from_wishlist accordingly.
    const trackWishlistClick = (btn) => {
      try {
        var productId = btn.getAttribute('data-product-id') || undefined;
        // Read state after Rivo toggles the active class on the button.
        setTimeout(function () {
          var isActive = btn.classList.contains('rivo-favorite-active');
          window.dataLayer = window.dataLayer || [];
          dataLayer.push({
            'event': isActive ? 'add_to_wishlist' : 'remove_from_wishlist',
            'source': 'rivo_wishlist_heart',
            'product_id': productId,
          });
        }, 150);
      } catch (err) {
        console.log('[Wishlist Debug] Error tracking wishlist click', err);
      }
    };
    // Delegated so it also covers buttons Rivo re-initializes dynamically.
    document.addEventListener('click', function (event) {
      var btn = event.target.closest && event.target.closest('rivo-favorite-button');
      if (btn) trackWishlistClick(btn);
    });
    const reInitWishlistBtns = (source = 'manual') => {
      try {
        const rivoAccountWidget = document.getElementById('rivo-account-slideout');
        if (window.RivoProfileAlpine && rivoAccountWidget) {
          console.log(`[Wishlist Debug] Reinitializing wishlist buttons (${source})`);
          window.RivoProfileAlpine.$data(rivoAccountWidget).initializeFavoriteButtons();
        }
      } catch (err) {
        console.log('[Wishlist Debug] Error initializing wishlist buttons', err);
      }
    };
    const setupGridWatcher = () => {
      // #ProductGridContainer is replaced wholesale by facets.js when filters or sort change.
      // Direct children only: Rivo injecting the heart icon must not retrigger a re-init.
      const grids = document.querySelectorAll('[data-infinite-scroll-results], #ProductGridContainer');
      if (!grids.length) return;
      let queued = false;
      const observer = new MutationObserver(() => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(() => {
          queued = false;
          reInitWishlistBtns('grid-change');
        });
      });
      grids.forEach((grid) => observer.observe(grid, { childList: true }));
    };
    reInitWishlistBtns('initial');
    setupGridWatcher();
  })();
</script>
<style>
  :root {
    --rivo-aw-favorite-button-active-color: #000000 !important;
  }
  .favorite-button-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    position: absolute;
    right: 0;
    z-index: 10;
  }
  rivo-favorite-button svg {
    position: static !important;
    stroke: #1d4d41 !important;
    stroke-width: 4px !important;
    height: 20px !important;
    margin: 0;
    z-index: 10 !important;
  }
  .favorite-button-wrapper rivo-favorite-button {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
</style>
{% if template.name == 'product' %}
  <style>
    .product-block__inner .favorite-button-wrapper:not(:first-child) {
      display: none !important;
    }
    .favorite-button-wrapper {
      position: static !important;
      right: auto !important;
      display: inline-flex !important;
      align-items: center !important;
      gap: 8px !important;
    }
    .favorite-button-wrapper > rivo-favorite-button {
      display: inline-flex;
      align-items: center;
      width: auto;
      height: auto;
    }
    .favorite-button-wrapper > rivo-favorite-button::after {
      {% comment %} content: "Add to Favorites"; {% endcomment %}
      margin-left: 8px;
      font-weight: 400;
      font-size: 14px;
      color: #1d4d41;
    }
    {% comment %} .favorite-button-wrapper > rivo-favorite-button.rivo-favorite-active::after {
      content: "In Your Favorites";
    } {% endcomment %}
    .product-list.swiper-container .favorite-button-wrapper,
    .product-list[data-products-in-view] .favorite-button-wrapper,
    .product-recommendations .favorite-button-wrapper,
    .related-products .favorite-button-wrapper,
    .recently-viewed .favorite-button-wrapper,
    .shopify-section--recommendations .favorite-button-wrapper {
      display: none !important;
    }
  </style>
{% endif %}