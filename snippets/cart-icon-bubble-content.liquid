{%- comment -%}
  Shared inner content of the #cart-icon-bubble anchor.

  Rendered inside the <a id="cart-icon-bubble"> wrapper in BOTH:
    - sections/header.liquid  (the live header cart icon)
    - sections/cart-icon-bubble.liquid  (re-fetched via the Section Rendering API on cart update)

  Keep this as the single source of truth. The cart scripts inject THIS content
  (the anchor's innerHTML) into the live header anchor — see cart.js / cart-drawer.js
  getSectionsToRender(). Do not duplicate this markup back into either anchor wrapper.
{%- endcomment -%}
<span class="sr-only">Cart</span>
<div class="cart-icon-bag">
  {%- render 'icon-bag', classes: 'h-6 w-6 hover:text-seaweed-500', aria_hidden: true, stroke_width: 1.75 -%}
  {%- if cart.item_count > 0 -%}
    <div class="cart-quantity-badge absolute top-1 right-0 w-auto h-4 min-w-4 px-0.5 bg-seafoam-300 rounded-full flex justify-center items-center border border-seaweed-700/50">
      <span class="cart-quantity-pulse-effect hidden" aria-hidden="true"></span>
      <span class="cart-quantity-value -mt-px font-medium text-sm">{{ cart.item_count }}</span>
      <span class="sr-only">items</span>
    </div>
  {%- endif -%}
</div>
