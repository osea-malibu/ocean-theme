{%- comment -%}
  Re-rendered via the Section Rendering API on cart update. The cart scripts read
  the INNER content of #cart-icon-bubble from this response and inject it into the
  live header anchor (sections/header.liquid). The anchor wrapper below exists only
  so the scripts can locate #cart-icon-bubble in the response — it is never displayed.
  Inner markup is shared via the cart-icon-bubble-content snippet to prevent drift.
{%- endcomment -%}
<a href="{{ routes.cart_url }}" class="header__icon--cart relative cursor-pointer flex w-10 h-10 justify-center items-center 2xs:ml-1 md:ml-2 -mr-1" id="cart-icon-bubble">
  {%- render 'cart-icon-bubble-content' -%}
</a>
