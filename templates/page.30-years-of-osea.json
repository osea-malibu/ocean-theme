    "multicolumn_8GHF7V": {
      "type": "multicolumn",
      "blocks": {
        "column_WeHJ8d": {
          "type": "column",
          "settings": {
            "column_classes": "lg:w-1/2 flex flex-col",
            "image": "shopify://shop_images/anniversary-3m.jpg",
            "is_bg_image": false,
            "image_link": "",
            "image_aria_label": "",
            "image_classes": "",
            "image_wrapper_classes": "order-2 mb-2 sm:mb-4 lg:hidden",
            "image_link_classes": "",
            "image_static_size": "",
            "text_classes": "",
            "remove_text_wrapper": true,
            "heading": "<h2 class=\"uppercase text-[2rem] sm:text-5xl xl:text-6xl whitespace-nowrap leading-tight xl:leading-none 2xl:text-7xl\">Behind the Bottle</h2>\n<em class=\"text-lg sm:text-2xl lg:hidden\">Exclusive Interview with Undaria Algae™ Body Oil</em>",
            "heading_classes": "font-serif mb-2 order-1",
            "paragraph": "<p class=\"font-book mb-4\"><em>One bottle sells every 30 seconds. Undaria Algae™ Body Oil has won numerous awards and built a dedicated, loyal following. We caught up with Undaria Algae™ Body Oil for her first sit-down interview:</em></p>\n\n<p class=\"mb-1\"><strong>How would you describe your personality?</strong></p>\n<p class=\"mb-4\">Deliciously rich but never greasy.</p>\n\n<p class=\"mb-1\"><strong>What's your greatest strength?</strong></p>\n<p class=\"mb-4\">I'm clinically shown to instantly improve the look of skin elasticity.</p>\n\n<p class=\"mb-1\"><strong>What's your biggest accomplishment?</strong></p>\n<p class=\"mb-4\">Winning awards is wonderful. Becoming someone's can't-live-without product is better.</p>\n\n<p class=\"mb-1\"><strong>What's your claim to fame?</strong></p>\n<p class=\"mb-4\">A full-body glow with an intoxicating scent! It's what I'm known for.</p>\n\n<p class=\"mb-1\"><strong>Any hidden talents?</strong></p>\n<p class=\"mb-4\">I play well with Undaria Algae Body Lotion, but I'm perfectly happy on my own.</p>\n\n<p class=\"mb-1\"><strong>What's the one thing you wish everyone knew?</strong></p>\n<p class=\"mb-4\">The seaweed sediment isn't a flaw. It's part of my story.</p>\n\n<p class=\"mb-1\"><strong>What's something people misunderstand about you?</strong></p>\n<p class=\"mb-4\">They think body oil has to feel heavy. I prefer to prove otherwise.</p>\n\n<p class=\"mb-1\"><strong>What's your love language?</strong></p>\n<p class=\"mb-4\">Acts of hydration.</p>\n\n<p class=\"mb-1\"><strong>How have you changed over the years?</strong></p>\n<p>I've only gotten better with age.</p>",
            "paragraph_classes": "order-3 sm:columns-2 sm:gap-x-6 md:gap-x-10 [column-fill:auto] sm:h-[560px] lg:h-[680px] xl:h-[560px] 2xl:h-[480px]",
