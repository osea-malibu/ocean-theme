        "paragraph_JM4jgR": {
          "type": "paragraph",
          "settings": {
            "paragraph_text": "<p>Since day one, our family has put our values into every product we make and into everything we do.  Our name, <b>OSEA</b>, is inspired by nature’s elements:  <b>Ocean</b>, <b>Sun</b>, <b>Earth</b>, <b>Atmosphere</b>. It’s our philosophy and practice that we protect the elements that we draw from. </p>",
            "paragraph_classes": "tracking-wide"
          }
        }
