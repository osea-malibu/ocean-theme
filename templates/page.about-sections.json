    "rich_text_BqhpCE": {
      "type": "rich-text",
      "blocks": {
        "heading_jfyybC": {
          "type": "heading",
          "settings": {
            "heading_text": "Thoughtfully Formulated",
            "heading_classes": "font-serif text-center text-3xl tracking-tight mb-4 max-w-sm mx-auto md:max-w-full",
            "subheading_text": "",
            "subheading_classes": "text-center mb-6 font-book tracking-wide text-lg"
          }
        },
        "paragraph_7UhUFR": {
          "type": "paragraph",
          "settings": {
            "paragraph_text": "<p>Since 1996, we've created clean, clinically tested skincare inspired by the sea. Every formula begins with carefully selected ingredients chosen for their safety, efficacy and sensorial experience. <em>Explore our full ingredient glossary <a href=\"https://oseamalibu.com/pages/ingredient-glossary?page=1&amp;sort=az&amp;listcount=10\" class=\"underline\">here</a>.</em></p>",
            "paragraph_classes": "tracking-wide mb-8"
          }
        },
        "heading_W9xRBM": {
          "type": "heading",
          "settings": {
            "heading_text": "Clean by Nature. Backed by Science.",
            "heading_classes": "font-serif text-center text-3xl tracking-tight mb-4 max-w-sm mx-auto md:max-w-full",
            "subheading_text": "",
            "subheading_classes": "text-center mb-6 font-book tracking-wide text-lg"
          }
        },
        "paragraph_qd7JPU": {
          "type": "paragraph",
          "settings": {
            "paragraph_text": "<p>We believe the best formulas begin with exceptional ingredients. That's why we combine nutrient-rich seaweed with active botanicals and proven ingredients to create clean, clinically tested skincare with visible results.</p>",
            "paragraph_classes": "tracking-wide mb-4"
          }
        },
        "paragraph_ngVQ7g": {
          "type": "paragraph",
          "settings": {
            "paragraph_text": "<modal-opener class=\"no-js-hidden block text-center\" data-modal=\"#IngredientsPopup\">\n    <button class=\"button button-secondary button-sm lg:button-md\" type=\"button\" aria-haspopup=\"dialog\">Our Free Of List</button>\n</modal-opener>\n\n<modal-dialog id=\"IngredientsPopup\">\n  <div role=\"dialog\" aria-label=\"Full ingredients list\" aria-modal=\"true\" class=\"!pr-4\" tabindex=\"-1\">\n    <button id=\"ModalClose-IngredientsPopup\" type=\"button\" aria-label=\"Close dialog\">✕</button>\n    <div class=\"w-full max-h-96 overflow-auto pr-4\">\n<p class=\"mb-4\">We choose to formulate without the following ingredients: </p>\n<ul class=\"icon-list bullet li:mb-1\">\n<li>Animal-derived ingredients</li>\n<li>Benzene/benzene compounds</li>\n<li>Coal tar ingredients</li>\n<li>Formaldehyde/formaldehyde releasers</li>\n<li>Gluten</li>\n<li>Heavy metal compounds</li>\n<li>Hydroquinone</li>\n<li>Nanoparticles</li>\n<li>Polyethylene Glycol compounds (PEGs)</li>\n<li>Parabens</li>\n<li>Phthalates</li>\n<li>Silicone-based compounds/polymers</li>\n<li>Sodium lauryl sulfate (SLS) and sodium laureth sulfate (SLES)</li>\n<li>Synthetic fragrance</li>\n<li>and many more</li>\n</ul>\n    </div>\n  </div>\n</modal-dialog>",
            "paragraph_classes": ""
          }
        }
      },
