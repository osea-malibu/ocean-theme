        "paragraph_cCLwXa": {
          "type": "paragraph",
          "settings": {
            "paragraph_text": "<p class=\"mb-3\">Our family's connection to the sea began more than 100 years ago.</p>\n<p class=\"mb-3\">Inspired by our great-grandmother Elsa's belief in the healing power of the ocean, Jenefer spent a decade developing seaweed-powered formulas before founding OSEA in 1996. More than 30 years later, OSEA remains family-owned and led by mother and daughter, creating clean, clinically tested skincare inspired by the sea.</p>\n<p class=\"mb-3\">Welcome to our family.</p>\n<img class=\"w-52 mx-auto mt-4\" alt=\"Signatures of OSEA founders Melissa and Jen\" src=\"https://cdn.shopify.com/s/files/1/1368/9993/files/melissa_jen_signature.png?v=1749241527\">\n<p>Jenefer, Founder &amp; Mother<br>\nMelissa, CEO &amp; Daughter\n</p>",
            "paragraph_classes": "tracking-wide text-center"
          }
        }
      },
      "block_order": [
        "heading_8XHEff",
        "paragraph_cCLwXa"
      ],
      "settings": {
        "section_heading": "",
        "section_classes": "container lg:max-w-screen-lg mt-6 mb-8",
        "container_classes": ""
      }
